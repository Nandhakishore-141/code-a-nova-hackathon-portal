{
  "name": "code-a-nova-hackathon-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Code-a-Nova National Collegiate Hackathon Portal",
  "scripts": {
    "build": "npm --prefix client run build",
    "client:install": "npm --prefix client install",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "server:install": "npm --prefix server install",
    "server:dev": "npm --prefix server run dev",
    "server:start": "npm --prefix server start",
    "install:all": "npm --prefix client install && npm --prefix server install"
  }
}
